# ---------------------------------------------------------------------------
# Copiez ce fichier en .env.local pour le développement,
# et collez les mêmes valeurs dans Vercel > Settings > Environment Variables.
#
# Les 3 premières se trouvent dans Supabase > Settings > API.
# ---------------------------------------------------------------------------

# Supabase > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase > Settings > API > Project API keys > anon / public
# Cette clé est publique par conception : elle est protégée par les règles RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase > Settings > API > Project API keys > service_role
# ⚠️  SECRÈTE. Ne JAMAIS la préfixer par NEXT_PUBLIC_ : elle contourne toutes
#     les règles RLS. `npm run check:secrets` vérifie qu'elle n'a pas fuité.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL publique de l'application (sans slash final)
# En local : http://localhost:3000 — en production : votre URL Vercel
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret partagé du cron anti-mise-en-veille de Supabase.
# Générez-le avec : openssl rand -hex 32
# Vercel l'envoie automatiquement dans l'en-tête Authorization des crons.
CRON_SECRET=
